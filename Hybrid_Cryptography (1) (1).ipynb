    "# Concatenate into one \"master text\" we can analyse.\n",
    "master_text = book1 + book2 + book3 + book4 + book5 + book6 \n",
    "\n",
    "def frequency_analysis(ciphertext): \n",
    "    # Calculate the frequency of each letter (uppercase or lowercase) in this master text.\n",
    "    letter_frequencies = []\n",
    "    for i in range(26):\n",
    "        letter_sum = master_text.count(ascii_lowercase[i]) + master_text.count(ascii_uppercase[i])\n",
    "    #Add to a list of tuples, the first element corresponding to the position of a letter in the alphabet and the second to the frequency.\n",
    "        letter_frequencies.append((i, letter_sum / len(master_text) * 100))\n",
    "\n",
    "    # Now sort.\n",
    "    letter_frequencies = sorted(letter_frequencies, key=lambda x: x[1]) \n",
    "    # key=lambda x: x[1] allows us to sort the tuples by the second element of the tuple; i.e. the frequency.\n",
    "\n",
    "    # Count the number of times each letter a-z appears in the ciphertext.\n",
    "    ciphertext_letter_frequencies = []\n",
    "    for i in range(len(ascii_lowercase)):\n",
    "        ciphertext_letter_sum = ciphertext.count(ascii_lowercase[i]) + ciphertext.count(ascii_uppercase[i])\n",
    "        ciphertext_letter_frequencies.append((i,ciphertext_letter_sum / len(ciphertext) * 100))\n",
    "    # Now sort\n",
    "    ciphertext_letter_frequencies = sorted(ciphertext_letter_frequencies, key=lambda x: x[1]) \n",
    "\n",
    "    # The key is given by the alphabetic shift between letters of the same frequency.\n",
    "    # The shift may vary slightly as letter frequencies vary.\n",
    "    # Hence will look at the shift for the five most common letters and use the one that appears the most. \n",
    "    candidates = []\n",
    "    for i in range(21,26):\n",
    "        candidates.append((ciphertext_letter_frequencies[i][0] - letter_frequencies[i][0])%26)\n",
    "    # Then find the most common shift among these five. This is our key.\n",
    "    key = max(set(candidates), key=candidates.count)\n",
    "    return decrypt_caesar_cipher(ciphertext, key)\n",
    "\n",
    "# Now we can encrypt a text to check the function.\n",
    "plaintext = get_plaintext(\"message_heart_of_darkness.txt\")\n",
    "plaintext2 = get_plaintext(\"message_emma.txt\")\n",
    "plaintext3 = get_plaintext(\"message_moby_dick.txt\")\n",
    "plaintext4 = get_plaintext(\"message_treasure_island.txt\")\n",
    "plaintext5 = get_plaintext(\"message_wuthering_heights.txt\")\n",
    "plaintext6 = get_plaintext(\"message_tomorrows_tangle.txt\")\n",
    "key = random.randint(0, 25)\n",
    "key2 = random.randint(0,25)\n",
    "key3 = random.randint(0,25)\n",
    "key4 = random.randint(0,25)\n",
    "key5 = random.randint(0,25)\n",
    "key6 = random.randint(0,25)\n",
    "ciphertext = caesar_cipher(plaintext, key)\n",
    "ciphertext2 = caesar_cipher(plaintext2, key2)\n",
    "ciphertext3 = caesar_cipher(plaintext3, key3)\n",
    "ciphertext4 = caesar_cipher(plaintext4, key4)\n",
    "ciphertext5 = caesar_cipher(plaintext5, key5)\n",
    "ciphertext6 = caesar_cipher(plaintext6, key6)\n",
    "\n",
    "assert frequency_analysis(ciphertext) == plaintext\n",
    "assert frequency_analysis(ciphertext2) == plaintext2\n",
    "assert frequency_analysis(ciphertext3) == plaintext3\n",
    "assert frequency_analysis(ciphertext4) == plaintext4\n",
    "assert frequency_analysis(ciphertext5) == plaintext5\n",
    "assert frequency_analysis(ciphertext6) == plaintext6"
   ]
