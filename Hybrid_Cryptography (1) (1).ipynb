    "\n",
    "for txt_file_name in message_files:\n",
    "    print(txt_file_name)\n",
    "    print('  Encoding: ' + test_encoding(txt_file_name))\n",
    "print()\n",
    "\n",
    "\n",
    "# A (test) function to reassure that the encoding well disguises the frequency of the letters.\n",
    "# It prints the highest and lowest frequencies (as percentages) before and after the encoding.\n",
    "\n",
    "def compare_frequencies(text_file_name):\n",
    "    plaintext = get_plaintext(text_file_name)\n",
