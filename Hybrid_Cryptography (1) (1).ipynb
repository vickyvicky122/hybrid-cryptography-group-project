  {
   "cell_type": "code",
   "execution_count": null,
   "id": "83761e0d-64e2-417e-a904-ac7915bce9d9",
   "metadata": {},
   "outputs": [],
   "source": [
    "#EXTENSION - Caelan\n",
    "\n",
    "# Adaptions made to part 1 and 2 functions are as follows:\n",
    "\n",
    "# Frequency analysis now uses the precomputed English frequencies , so they aren't rebuilt for every call, taking that part out of the loop from Q2\n",
    "#This is handled by the addition of get_english_language_frequencies\n",
    "# Frequency analysis is performed slightly differently, just looking at the most frequent letter in a piece of cipher text, and we just return a key instead of performing shift\n",
    "# Now when we decrypt vigenere we can try to decrypt without a key, but using a key to test the decryption function itself is still permitted, as well as return information on what happened during the process\n",
    "# Modified the old test_vigenere to report what type of failure occurs as well as success\n",
    "\n",
    "\n",
    "# Totally new functions core to the extension are: find_vigenere_key_length, split_text_by_key_length and run_trials\n",
    "\n",
    "   \n",
    "def get_english_language_frequencies(master_text):   \n",
    "    # Calculate the frequency of each letter (uppercase or lowercase) in a master text.\n",
    "    letter_frequencies = []\n",
    "    for i in range(26):\n",
    "        letter_sum = master_text.count(ascii_lowercase[i]) + master_text.count(ascii_uppercase[i])\n",
    "    # Add to a list of tuples, the first element corresponding to the position of a letter in the alphabet and the second to the frequency.\n",
    "        letter_frequencies.append((i, letter_sum / len(master_text)))\n",
    "    \n",
    "    # Now sort.\n",
    "    return sorted(letter_frequencies, key=lambda x: x[1]) \n",
    "    # key=lambda x: x[1] allows us to sort the tuples by the second element of the tuple; i.e. the frequency.\n",
    "\n",
    "#We get our list of letter frequencies for the English language and declare it globally\n",
    "letter_frequencies = get_english_language_frequencies(master_text)\n",
    "\n",
    "def shift_from_frequency_analysis(ciphertext):\n",
    "    # Count the number of times each letter a-z appears in the ciphertext.\n",
    "    ciphertext_letter_frequencies = []\n",
    "    for i in range(len(ascii_lowercase)):\n",
    "        ciphertext_letter_sum = ciphertext.count(ascii_lowercase[i]) + ciphertext.count(ascii_uppercase[i])\n",
    "        ciphertext_letter_frequencies.append((i,ciphertext_letter_sum / len(ciphertext)))\n",
    "    # Now sort\n",
    "    ciphertext_letter_frequencies = sorted(ciphertext_letter_frequencies, key=lambda x: x[1]) \n",
    "\n",
    "    # The key is given by the alphabetic shift between letters of the same frequency.    \n",
    "    # We just use the shift determined by what lines up with e, the most common letter in the English  language\n",
    "    key = ((ciphertext_letter_frequencies[25][0] - letter_frequencies[25][0])%26)\n",
    "    #Unlike the earlier function which performs a shift, we return just the key\n",
    "    return key\n",
    "\n",
    "\n",
    "def find_vigenere_key_length(ciphertext, verbose = False):    \n",
    "    \"\"\"Given a piece of text, this routine finds repeated 3 grams of text,\n",
    "        and calculates the distance between them. It then uses a voting system \n",
    "        to decide on a candidate for the key length, using the gcd function defined earlierto aid in this.\"\"\"\n",
    "    # We declare three empty lists to keep track as we iterate through the text\n",
    "    unique_3_grams = []\n",
    "    length_array = []\n",
    "    repeated_3_grams = []   \n",
    "    for i in range(len(ciphertext)-2):\n",
    "        # Look at the current 3-gram\n",
    "        current_3_gram = ciphertext[i:i+3].lower()\n",
    "        # If it is new, then we look for repeats in the text\n",
    "        if current_3_gram not in unique_3_grams:\n",
    "            unique_3_grams.append(current_3_gram)\n",
    "            last_instance = i\n",
    "            # We deal fully with a unique 3-gram once we have found it\n",
    "            for j in range(i+1, len(ciphertext)-2):               \n",
    "                text_slice = ciphertext[j:j+3].lower()\n",
    "                # If we find a repeat in the text, then we add it to our repeat array, and record the distance from the last repeat\n",
    "                if text_slice == current_3_gram:\n",
    "                    if text_slice not in repeated_3_grams:\n",
    "                        repeated_3_grams.append(text_slice)\n",
    "                        # We add the distance between occurrences to the length array\n",
    "                        length_array.append(j-last_instance)\n",
    "                    # However, if there are more than two occurrences of a 3-gram, we take the gcd of the distances between each occurrence\n",
    "                    # They all fold in to provide one distance per 3-gram, which we will use to vote on a final candidate\n",
    "                    else:\n",
    "                        length_array[-1] = gcd(length_array[-1], j-last_instance)\n",
    "                    # Update the last instance to find the next distance\n",
    "                    last_instance = j  \n",
    "    # We remove any candidates that are less than length 3, because these will most likely be chance repeats that could affect the calculation. \n",
    "    # We also remove proposals for very large key lengths. This is because they will not yield enough characters for successful frequency analysis (reject keys resulting in less than 20 characters).\n",
    "    length_array = [x for x in length_array if 3 <= x <= len(ciphertext) // 20]\n",
    "    if verbose:\n",
    "        print (\"The key length candidates are: {}\".format(length_array))\n",
    "    # Each candidate for key length now votes on its divisors, provided we have been able to find repeated 3-grams\n",
    "    if len(length_array) != 0:     \n",
    "        # We create a list of 0s, which will be used to keep track of votes for divisors\n",
    "        votes = [0] * (max(length_array) + 1)\n",
    "        # For each potential key length, we add a vote for each of its divisors\n",
    "        for candidate in length_array:\n",
    "            for i in range(3,candidate + 1):\n",
    "                if candidate % i == 0:\n",
    "                    votes[i] += 1\n",
    "        # The value with the most votes will either be the key or a factor of the key length, set the amount of votes to best\n",
    "        best = max(votes)\n",
    "        # We then work backwards through our votes list. To find our candidate for the key length, we use a tolerance of 0.8.\n",
    "        # The largest divisor that has enough votes within this tolerance will be the value we choose for the key length.\n",
    "        # This tolerance helps us identify key lengths which have smaller key factors that would beat them in the vote\n",
    "        for i in range(len(votes) -1, 2, -1):\n",
    "            # Note: 0.8 was found through testing to have a good success rate, 0.9 was too strict and let smaller divisors beat the true length frequently\n",
    "            if (votes[i] >= 0.8 * best):\n",
    "                if verbose:\n",
    "                    print(\"The supposed key length is:\", i)\n",
    "                # Will always return something as \"best\" will satisfy this by definition\n",
    "                return i\n",
    "    # If no useable candidates are found then we return -1\n",
    "    else:\n",
    "        return -1\n",
    "       \n",
    "def split_text_by_key_length(ciphertext,key_length):\n",
    "    \"\"\"Given a piece of text and a key length, this routine returns a list of strings, whose characters are of key length apart in the text. \n",
    "        These will then be analysed individually with frequency analysis to decrypt the vigenere cipher.\"\"\"\n",
    "    # The list of strings we will return\n",
    "    char_strings = []\n",
    "    for i in range(key_length):      \n",
    "        all_found = False\n",
    "        index = i\n",
    "        # One string will be constructed for every value in the key. We add the first character to start.\n",
    "        current_string = ciphertext[i]\n",
    "        # This loop will assemble all the characters of keylength apart from a given starting point\n",
    "        while all_found == False:\n",
    "            if (index+key_length >= len(ciphertext)):\n",
    "                all_found = True\n",
    "            else:\n",
    "                index = index + key_length\n",
    "                current_string += ciphertext[index]\n",
    "        char_strings.append(current_string)\n",
    "    # Check we have a string to analyse for each shift from the key\n",
    "    assert(len(char_strings) == key_length)\n",
    "    return(char_strings)\n",
    "\n",
    "def decrypt_vigenere_kasiski(ciphertext, key = None, verbose = False):\n",
    "    \"\"\"Given a piece of ciphertext only, this method first will call functions to perform a Kasiski analysis on the ciphertext, calling the functions defined above to find a candidate for the key.\n",
    "        If a key is provided, this step will be skipped. Then using the key either found or provided, the cipher text will be decrypted and the plaintext returned.\"\"\"\n",
    "    # If no key was provided to decrypt, we perform a Kasiski style analysis to find a candidate\n",
    "    if key is None:\n",
    "        # We find a key length guess using find_vigenere_key_length\n",
    "        key_length_guess = find_vigenere_key_length(ciphertext,verbose = verbose)\n",
    "        # If the method fails and returns -1, we return None\n",
    "        if key_length_guess == -1:\n",
    "            if verbose:                    \n",
    "                print(\"No useable key length found.\")\n",
    "            return (None, -1)\n",
    "        # We split our text using our key length guess and get strings we can analyse using frequency analysis\n",
    "        char_strings = split_text_by_key_length(ciphertext,key_length_guess)\n",
    "        # This will be added to as we perform frequency analysis on our character strings, giving us our guess for the key\n",
    "        key_string = \"\"\n",
    "        # Loop through and perform frequency analysis on each string\n",
    "        for char_string in char_strings:\n",
    "            key = shift_from_frequency_analysis(char_string)\n",
    "            key_string += str(ascii_lowercase[key])\n",
    "        # Set our value of key to this string\n",
    "        key = key_string \n",
    "        if verbose:              \n",
    "            print(\"The key found by Kasiski analysis is: {}\".format(key_string))\n",
    "    # Now, we either use the key found using Kasiski analysis, or the one given        \n",
    "    length = len(key)\n",
    "    plaintext = ''\n",
    "    # Iterate through each letter in the ciphertext\n",
    "    for i in range(len(ciphertext)):\n",
    "        # Work out the corresponding caesar key to the letter\n",
    "        number = ascii_lowercase.index((key[i % length].lower()))\n",
    "        # Decrypt the letter\n",
    "        plaintext += decrypt_caesar_cipher(ciphertext[i], number)\n",
    "    # Return the decrypted plaintext\n",
    "    return plaintext, length\n",
    "\n",
    "\n",
    "def test_vigenere_kasiski(plaintext, key_length, use_key = True, verbose = False):\n",
    "    \"\"\"This function will test the ability to encrypt and decrypt a piece of text using the vigenere cipher. It will generate a random key of key_length, passed by the user.\n",
    "        It will then encrypt the plaintext using this key. To decrypt, if use_key is true, it will just use the key we generated to decrypt and check it is equal to the plaintext.\n",
    "        Otherwise, Kasiski analysis will be performed to achieve a guess for the key, which will be used to decrypt. Again this will be checked against the plaintext.\n",
    "        Tuples returned to track failure types\"\"\"\n",
    "    key = ''\n",
    "    # Generating some random key to encrypt with\n",
    "    for i in range(key_length):\n",
    "        key += ascii_lowercase[random.randint(0, 25)]\n",
    "    if verbose:           \n",
    "        print(\"The true key is {}.\".format(key))\n",
    "    # Encrypt the message\n",
    "    ciphertext_test =  vigenere_cipher(plaintext, key)\n",
    "    # Decrypt with true key if we want to just check function of the decrypt method\n",
    "    if use_key == True:      \n",
    "        plaintext_test, guessed_key_length = decrypt_vigenere_kasiski(ciphertext_test, key, verbose = verbose)\n",
    "    # Find and decrypt with the key from Kasiski analysis\n",
    "    else:\n",
    "        plaintext_test, guessed_key_length = decrypt_vigenere_kasiski(ciphertext_test, key = None, verbose = verbose)\n",
    "    # Error message if we couldn't perform the analysis, and a value to indicate failure type\n",
    "    if (plaintext_test) is None or (guessed_key_length != key_length):\n",
    "        return ('Kasiski analysis failed', 0)\n",
    "    # Finally, we determine the outcome of the encryption/decryption by comparing it to the original plaintext\n",
    "    elif plaintext_test == plaintext:\n",
    "        return ('Test passed', 1)\n",
    "    return ('Test failed, key = ' + key, 2)\n",
    "\n",
    "\n",
    "#TESTING\n",
    "\n",
    "#First we test that the process vigenere encryption and decryption with the same key works on the text\n",
    "print(test_vigenere_kasiski(get_plaintext('message_emma.txt'),6, use_key=True, verbose = True)[0])\n",
    "print()\n",
    "#We test the same piece of text again, decrypting without using the encryption key and using Kasiski analysis instead\n",
    "print(test_vigenere_kasiski(get_plaintext('message_emma.txt'),6, use_key=False, verbose = False)[0])\n",
    "print()\n",
    "\n",
    "#We now perform random tests on different random chunks of text from the master text, and observe how different changes affect the reliability of our algorithm\n",
    "def run_trials(text_length, key_length, num_trials):\n",
    "    #Initialise counters to track failure types\n",
    "    passed = kasiski_failures = failed = 0\n",
    "    for i in range(num_trials): \n",
    "        #Get a random chunk of text of the specified length\n",
    "        upper = random.randint(text_length,len(master_text))\n",
    "        lower = upper - text_length\n",
    "        #Finds out if we succeeded or how we failed, and adds one to the corresponding tally\n",
    "        val = test_vigenere_kasiski(master_text[lower:upper],key_length, use_key=False, verbose = False)[1]\n",
    "        if val == 0:\n",
    "            kasiski_failures += 1\n",
    "        elif val == 1:\n",
    "            passed += 1\n",
    "        else:\n",
    "            failed += 1\n",
    "    print(\"Over {} trials, for a text of length {} and a key of length {}, we had the following results:\".format(num_trials, text_length, key_length))\n",
    "    print(\"The process was successful {} times.\\nKasiski analysis of positions failed {} times.\\nFrequency analysis failed {} times.\".format(passed,kasiski_failures, failed))\n",
    "    print()\n",
    "\n",
    "#We carry out some tests and observe results\n",
    "#Note that taking text from the master text does flatter the frequency step a bit, but it is the easiest way for us to test large random chunks of english text in this code\n",
    "run_trials(text_length = 100, key_length = 4, num_trials = 20)\n",
    "run_trials(text_length = 1000, key_length = 6, num_trials = 20)\n",
    "run_trials(text_length = 5000, key_length = 6, num_trials = 10)\n",
    "run_trials(text_length = 5000, key_length = 15, num_trials = 10)\n",
