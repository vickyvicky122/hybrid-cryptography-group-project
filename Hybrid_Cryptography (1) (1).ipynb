   "id": "q4-encoding",
   "metadata": {},
   "outputs": [],
   "source": [
    "# QUESTION 4 - Viktoriia\n",
    "\n",
    "# Generate list of all the 2-grams made up of two distinct letters. There are 26*25 = 650 of these.\n",
    "all_bigrams = []\n",
    "for i in ascii_lowercase:\n",
    "    for j in ascii_lowercase:\n",
    "        if i != j:\n",
    "            all_bigrams.append(i + j)\n",
    "\n",
    "# Next use the frequency of each letter in English, worked out from the master text of Question 2.\n",
    "# english_frequencies[0] is the frequency of 'a', english_frequencies[1] is the frequency of 'b' and so on.\n",
    "english_frequencies = []\n",
    "for i in range(26):\n",
    "    letter_sum = master_text.count(ascii_lowercase[i]) + master_text.count(ascii_uppercase[i])\n",
    "    english_frequencies.append(letter_sum / len(master_text))\n",
    "\n",
    "\n",
    "# A function to generate a random encoding of each letter into one or more 2-grams.\n",
    "def generate_encoding(number_bigrams=400):\n",
    "    # shuffle a copy of the list of 2-grams so that the 2-grams given to each letter are random\n",
    "    bigrams = all_bigrams.copy()\n",
    "    random.shuffle(bigrams)\n",
    "    encoding = {}\n",
    "    position = 0\n",
    "    for i in range(26):\n",
    "        # The number of 2-grams given to a letter is proportional to its frequency,\n",
    "        # for example a letter with frequency 1.5% is given 0.015 * 400 = 6 of them, as per project brief.\n",
    "        # Every letter needs at least one 2-gram. \n",
    "        size = max(1, round(english_frequencies[i] * number_bigrams))\n",
    "        encoding[ascii_lowercase[i]] = bigrams[position:position + size]\n",
    "        position += size\n",
    "    # check that all_bigrams list is not exceeded\n",
    "    assert position <= len(all_bigrams)\n",
    "    return encoding\n",
    "\n",
    "\n",
    "# Now functions to encode and decode a message.\n",
    "# As with the ciphers the case of each letter is preserved, so 'e' might become 'qx' and 'E' might become 'QX'.\n",
    "\n",
    "def encode_message(plaintext, encoding):\n",
    "    encoded_text = ''\n",
    "    # iterate through each letter in the plaintext\n",
    "    for i in plaintext:\n",
    "        # choose at random one of the 2-grams which represent this letter\n",
    "        choices = encoding[i.lower()]\n",
    "        bigram = choices[random.randint(0, len(choices) - 1)]\n",
    "        if i in ascii_uppercase:\n",
    "            bigram = bigram.upper()\n",
    "        encoded_text += bigram\n",
    "    return encoded_text\n",
    "\n",
    "def decode_message(encoded_text, encoding):\n",
    "    # first turn the encoding around so that we can look up the letter which each 2-gram represents\n",
    "    decoding = {}\n",
    "    for letter in encoding:\n",
    "        for bigram in encoding[letter]:\n",
    "            decoding[bigram] = letter\n",
    "    plaintext = ''\n",
    "    # iterate through each 2-gram in the encoded text\n",
    "    for i in range(0, len(encoded_text), 2):\n",
    "        bigram = encoded_text[i:i + 2]\n",
    "        letter = decoding[bigram.lower()]\n",
    "        if bigram[0] in ascii_uppercase:\n",
    "            letter = letter.upper()\n",
    "        plaintext += letter\n",
    "    return plaintext\n",
    "\n",
    "\n",
    "# Next functions to record the encoding in a key and to get the encoding back from the key.\n",
    "# The key is the 2-grams for 'a', then a comma, then the 2-grams for 'b', then a comma and so on,\n",
    "# for example 'qzbnlk,tyop,...' means 'a' is represented by 'qz', 'bn' and 'lk' and 'b' is represented by 'ty' and 'op'.\n",
    "\n",
    "def encoding_to_key(encoding):\n",
    "    parts = []\n",
    "    for letter in ascii_lowercase:\n",
    "        parts.append(''.join(encoding[letter]))\n",
    "    return ','.join(parts)\n",
    "\n",
    "def key_to_encoding(encoding_key):\n",
    "    parts = encoding_key.split(',')\n",
    "    encoding = {}\n",
    "    for i in range(26):\n",
    "        # split the 2-grams for this letter back up into a list\n",
    "        bigrams = []\n",
    "        for j in range(0, len(parts[i]), 2):\n",
    "            bigrams.append(parts[i][j:j + 2])\n",
    "        encoding[ascii_lowercase[i]] = bigrams\n",
    "    return encoding\n",
    "\n",
    "\n",
    "# A test function to test the encoding and decoding with a random encoding\n",
    "\n",
    "def test_encoding(text_file_name):\n",
    "    # get the plaintext and generate a random encoding\n",
    "    plaintext = get_plaintext(text_file_name)\n",
    "    encoding = generate_encoding()\n",
    "    # then encode the message\n",
    "    encoded_text = encode_message(plaintext, encoding)\n",
    "    # decode using the encoding we get back from the key, as this is what the receiver will have to do\n",
    "    encoding_key = encoding_to_key(encoding)\n",
    "    plaintext_test = decode_message(encoded_text, key_to_encoding(encoding_key))\n",
    "    # finally check the decoding matches the original input\n",
    "    if plaintext_test == plaintext:\n",
    "        return 'Test passed'\n",
