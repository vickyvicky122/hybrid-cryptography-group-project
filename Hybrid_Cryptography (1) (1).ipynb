   "source": [
    "def vigenere_cipher(plaintext, key):\n",
    "    # Note that for the vigenere cipher, the key is a word.\n",
    "    length = len(key)\n",
    "    cipher_text = ''\n",
    "    # iterate through each index in the plaintext and key\n",
    "    for i in range(len(plaintext)):\n",
    "        # use the index function to get the corresponding number\n",
    "        number = ascii_lowercase.index((key[i % length].lower()))\n",
    "        # use the caesar_cipher function from above\n",
    "        cipher_text += caesar_cipher(plaintext[i], number)\n",
    "    return cipher_text"
   ]
  },
