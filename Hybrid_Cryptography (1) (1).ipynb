   "id": "q4-hybrid",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Put everythibg togetehr for a hybrid system:\n",
    "# message is now randomly encoded before Vigenère encryption,\n",
    "# decoded after Vigenère decryption,\n",
    "# encoding information should be recorded in a key which is then appended to the Vigenère key\n",
    "# the resulting string is sliced, RSA encrypted and transmitted as a tuple. \n",
    "\n",
    "def rsa_encrypt_encoded(txt, pub, key=None, num_bigrams=400):\n",
    "\n",
    "    # First we generate a random encoding and use it to encode the message.\n",
    "\n",
    "    plaintext = get_plaintext(txt)\n",
    "    encoding = generate_encoding(num_bigrams)\n",
    "    encoded_text = encode_message(plaintext, encoding)\n",
    "\n",
    "    # \"key\" is the Vigenere key to use. If not given a random one is generated as in Q3.\n",
    "\n",
    "    if key is None:\n",
    "        key_len = random.randint(1, len(encoded_text))\n",
    "        key = ''\n",
    "        for i in range(key_len):\n",
    "            key += ascii_lowercase[random.randint(0, 25)]\n",
    "\n",
    "    # We apply the Vigenere cipher to the encoded text.\n",
    "\n",
    "    cipher_txt = vigenere_cipher(encoded_text, key)\n",
    "\n",
    "    # The encoding key is appended to the Vigenere key.\n",
    "    # We put a '|' between them so that the receiver can tell where the Vigenere key ends (the Vigenere key only contains letters).\n",
    "\n",
    "    full_key = key + '|' + encoding_to_key(encoding)\n",
    "    rsa_key = []\n",
    "    for s in key_slice(full_key):\n",
    "        rsa_key.append(pow(int(s), pub[1], pub[0]))\n",
    "\n",
    "    return tuple(rsa_key), cipher_txt\n",
    "\n",
    "def decrypt_encoded(key, cipher_txt, pub, priv):\n",
    "\n",
    "    # We undo the RSA encryption with the private key and turn the digits back into characters as in Question 3.\n",
    "\n",
    "    decrypted = []\n",
    "    for i in key:\n",
    "        decrypted.append(str(pow(i, priv, pub[0])))\n",
    "    full_key = ''\n",
    "    group = ''.join(decrypted)\n",
    "\n",
    "    for j in range(0, len(group), 3):\n",
    "        x = slice(j, j+3)\n",
    "        full_key = full_key + chr(int(group[x]) - 256)\n",
    "\n",
    "    # Separate the Vigenere key from the encoding key.\n",
    "\n",
    "    index = full_key.index('|')\n",
    "    vigenere_key = full_key[:index]\n",
    "    encoding = key_to_encoding(full_key[index + 1:])\n",
    "\n",
    "    # Finally we apply the Vigenere decryption and then decode the result to get the message.\n",
    "\n",
    "    encoded_text = decrypt_vigenere_cipher(cipher_txt, vigenere_key)\n",
    "    return decode_message(encoded_text, encoding)\n",
    "\n",
    "\n",
    "# Functions to run the system to and from files. \n",
    "\n",
    "def hybrid_encrypt_file_encoded(input_file_name, cipher_file_name, key_file_name, pub, key=None):\n",
    "\n",
    "    # The ciphertext is written to one file and the RSA encrypted slices of the keys to another, one integer per line.\n",
    "\n",
    "    rsa_key, cipher_txt = rsa_encrypt_encoded(input_file_name, pub, key)\n",
    "    write_text(cipher_file_name, cipher_txt)\n",
    "    write_text(key_file_name, '\\n'.join(str(i) for i in rsa_key))\n",
    "    return rsa_key, cipher_txt\n",
    "\n",
    "def hybrid_decrypt_file_encoded(cipher_file_name, key_file_name, output_file_name, pub, priv):\n",
    "\n",
    "    # We read the ciphertext and the encrypted slices of the keys back from their files.\n",
    "\n",
    "    cipher_txt = get_plaintext(cipher_file_name)\n",
    "    with open(key_file_name, \"r\") as file:\n",
    "        rsa_key = tuple(int(line) for line in file.read().split())\n",
    "\n",
    "    # Then we decrypt as above and write the result to the output file.\n",
    "\n",
    "    raw = decrypt_encoded(rsa_key, cipher_txt, pub, priv)\n",
    "    write_text(output_file_name, raw)\n",
    "    return raw\n",
    "\n",
    "\n",
    "# Finally, test the whole system to and from files with random keys.\n",
    "# For a file called name.txt this creates the files encoded_cipher_name.txt, encoded_key_name.txt and encoded_decrypted_name.txt.\n",
    "\n",
    "def test_hybrid_encoded(txt_file_name, pub, priv):\n",
    "    cipher_file_name = 'encoded_cipher_' + txt_file_name\n",
    "    key_file_name = 'encoded_key_' + txt_file_name\n",
    "    decrypted_file_name = 'encoded_decrypted_' + txt_file_name\n",
    "    # encrypt the file with a random encoding and a random Vigenere key, then decrypt the encrypted file\n",
    "    hybrid_encrypt_file_encoded(txt_file_name, cipher_file_name, key_file_name, pub)\n",
    "    hybrid_decrypt_file_encoded(cipher_file_name, key_file_name, decrypted_file_name, pub, priv)\n",
    "    # finally check the decrypted file matches the alphabetic content of the original file\n",
    "    if get_plaintext(decrypted_file_name) == get_plaintext(txt_file_name):\n",
    "        return 'Test passed'\n",
    "    return 'Test failed'\n",
    "\n",
    "# Alice generates her keys and then we run the test on every message file.\n",
    "pub, priv, fact = RSA_key_generator()\n",
    "\n",
    "for txt_file_name in message_files:\n",
    "    print(txt_file_name)\n",
    "    print('  Hybrid system with encoding: ' + test_hybrid_encoded(txt_file_name, pub, priv))"
   ]
