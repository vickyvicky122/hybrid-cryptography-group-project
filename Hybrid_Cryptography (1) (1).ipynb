    "    print('  Letters in the encoded text:  highest {:.2f}%, lowest {:.2f}%'.format(max(encoded_frequencies), min(encoded_frequencies)))\n",
    "    print('  2-grams in the encoded text:  highest {:.2f}%, lowest {:.2f}% ({} different 2-grams used)'.format(max(bigram_frequencies), min(bigram_frequencies), len(bigram_frequencies)))\n",
    "\n",
    "compare_frequencies('message_heart_of_darkness.txt')\n",
    "compare_frequencies('message_emma.txt')"
   ]
